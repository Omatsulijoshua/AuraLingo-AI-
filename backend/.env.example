# Server Config
PORT=5000
NODE_ENV=development

# Database Config
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/bandup_ielts?schema=public"

# Auth Config
JWT_SECRET="super-secret-jwt-signing-key-change-in-production"
JWT_REFRESH_SECRET="super-secret-jwt-refresh-signing-key-change-in-production"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Security Config (Must be 32 bytes for AES-256-GCM encryption)
ENCRYPTION_KEY="12345678901234567890123456789012"

# Payment Gateways (Stripe & Paystack)
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
PAYSTACK_SECRET_KEY="sk_test_..."
FLUTTERWAVE_SECRET_KEY="FLWSECK_TEST-..."

# CORS Config
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:3001"
