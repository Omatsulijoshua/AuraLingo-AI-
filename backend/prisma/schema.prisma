generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  ADMIN
  TUTOR
  STUDENT
}

enum CefrLevel {
  A1
  A2
  B1
  B2
  C1
  C2
}

enum LearningGoal {
  CAREER
  RELOCATION
  TRAVEL
  EXAM_PREP
  DATING
  CASUAL
}

enum ErrorCategory {
  GRAMMAR
  VOCABULARY
  PRONUNCIATION
  SYNTAX
  CULTURAL_PRAGMATICS
}

model User {
  id              String           @id @default(uuid())
  email           String           @unique
  password        String
  name            String
  role            Role             @default(STUDENT)
  isVerified      Boolean          @default(false)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  languageProfile LanguageProfile?
  scenarios       ScenarioSession[]
  errorLogs       ErrorLog[]
}

model LanguageProfile {
  id             String       @id @default(uuid())
  userId         String       @unique
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  nativeLanguage String       @default("English")
  targetLanguage String       @default("Spanish")
  cefrLevel      CefrLevel    @default(B1)
  goal           LearningGoal @default(CAREER)
  dailyMinutes   Int          @default(20)
  studyStreak    Int          @default(7)
  isOnboarded    Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model ScenarioSession {
  id           String             @id @default(uuid())
  userId       String
  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  scenarioId   String
  title        String
  category     String
  cefrLevel    CefrLevel          @default(B1)
  tutorName    String
  tutorRole    String
  createdAt    DateTime           @default(now())
  turns        ConversationTurn[]
}

model ConversationTurn {
  id           String          @id @default(uuid())
  sessionId    String
  session      ScenarioSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sender       String          // USER or AI_TUTOR
  text         String
  pronunciationScore Int?
  grammarDiff  String?
  vocabUpgrade String?
  culturalTip  String?
  createdAt    DateTime        @default(now())
}

model ErrorLog {
  id             String        @id @default(uuid())
  userId         String
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  category       ErrorCategory
  originalPhrase String
  correctedPhrase String
  explanation    String
  recurrenceCount Int          @default(1)
  masteryLevel   Int           @default(20)
  targetLanguage String        @default("Spanish")
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
}
